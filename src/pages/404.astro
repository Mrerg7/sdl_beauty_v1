---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Base title="Page Not Found — SDL Beauty">
  <Nav />
  <main id="main-content" style="min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:var(--space-16) var(--space-4)">
    <div>
      <p style="font-family:'Cormorant Garamond',serif;font-size:var(--text-3xl);font-weight:300;color:rgba(184,150,90,.25);line-height:1">404</p>
      <h1 style="font-size:var(--text-xl);font-weight:300;margin-top:var(--space-4);margin-bottom:var(--space-4)">Page not found</h1>
      <p style="color:var(--color-text-muted);margin-bottom:var(--space-8)">The address you entered doesn't exist on this site.</p>
      <a href="/" class="btn-cta">Return home</a>
    </div>
  </main>
  <Footer />
</Base>
