---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title = 'sdl.beauty | Premium Domain for Sale | SDL Beauty — Scottsdale Luxury Med Spa Brand',
  description = 'sdl.beauty for sale — premium 3-letter .beauty domain + turnkey Scottsdale luxury med spa brand. Available now via escrow-secured transfer. Contact sales@desertrich.com to acquire or make an offer.',
  ogImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/70f9edbb-f745-453c-c1e3-0547940a9100/public',
  canonicalURL = Astro.url.href,
} = Astro.props;

const siteName = 'SDL Beauty';
const lcpImage = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/70f9edbb-f745-453c-c1e3-0547940a9100/public';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://sdl.beauty/#website",
      "url": "https://sdl.beauty/",
      "name": "SDL Beauty",
      "description": description,
      "inLanguage": "en-US",
      "potentialAction": {
        "@type": "ContactAction",
        "target": "mailto:sales@desertrich.com",
        "name": "Acquire This Brand"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://sdl.beauty/#org",
      "name": "SDL Beauty",
      "url": "https://sdl.beauty/",
      "logo": ogImage,
      "email": "sales@desertrich.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Scottsdale",
        "addressRegion": "AZ",
        "addressCountry": "US"
      }
    },
    {
      "@type": ["LocalBusiness", "HealthAndBeautyBusiness"],
      "@id": "https://sdl.beauty/#business",
      "name": "SDL Beauty",
      "description": description,
      "url": "https://sdl.beauty/",
      "logo": ogImage,
      "image": ogImage,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Scottsdale",
        "addressRegion": "AZ",
        "addressCountry": "US"
      },
      "priceRange": "$$$",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "sales@desertrich.com",
        "contactType": "sales"
      },
      "sameAs": ["https://sdl.beauty/"]
    },
    {
      "@type": "Product",
      "@id": "https://sdl.beauty/#domain-product",
      "name": "sdl.beauty — Premium Domain + Luxury Med Spa Brand",
      "description": "Premium 3-letter .beauty domain with turnkey Scottsdale luxury med spa brand identity and positioning. Escrow-secured transfer.",
      "brand": { "@type": "Brand", "name": "SDL Beauty" },
      "category": "Premium domain names / brand acquisition",
      "image": ogImage,
      "url": "https://sdl.beauty/",
      "isRelatedTo": { "@id": "https://sdl.beauty/#business" }
    },
    {
      "@type": "Offer",
      "@id": "https://sdl.beauty/#offer",
      "name": "SDL Beauty Brand Acquisition",
      "description": "Premium luxury med spa brand available for acquisition. Includes sdl.beauty domain, brand identity, and Scottsdale market positioning. Escrow-secured transfer, confidential inquiry.",
      "seller": {
        "@type": "Organization",
        "name": "Desert Rich",
        "email": "sales@desertrich.com"
      },
      "areaServed": { "@type": "Place", "name": "Scottsdale, Arizona" },
      "category": "Brand Acquisition",
      "availability": "https://schema.org/InStock",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "USD",
        "description": "Price on application — serious offers invited"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://sdl.beauty/#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sdl.beauty/" }
