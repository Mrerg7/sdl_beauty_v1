---
<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#171208" media="(prefers-color-scheme: dark)" />
  <meta name="color-scheme" content="light dark" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="g8CKpIgVYfdVMt8e9ICTYqIG2e2557HczUka9HwHV1c" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="buy .beauty domains, sdl.beauty for sale, premium domain names, luxury med spa brand Scottsdale, domain marketplace, investment domains, brandable domains" />
  <meta name="author" content="SDL Beauty" />
  <meta name="geo.region" content="US-AZ" />
  <meta name="geo.placename" content="Scottsdale" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:site_name"   content={siteName} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"   content="SDL Beauty — Scottsdale luxury med spa brand, sdl.beauty premium domain for sale" />
  <meta property="og:locale"      content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />
  <meta name="twitter:image:alt"   content="SDL Beauty — sdl.beauty premium domain for sale" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Performance: preconnect + LCP preload -->
  <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" /></noscript>

  <!-- PWA / icons -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23b8965a'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='Georgia' font-size='16' font-weight='600' fill='white'%3ES%3C/text%3E%3C/svg%3E" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <script is:inline>
    try {
      const t = localStorage.getItem('sdl-theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.dataset.theme = 'dark';
      }
    } catch (e) {}
  </script>

  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn-cta">Skip to content</a>
  <slot />
  <script>
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); }
      }),
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    // Lightweight CTA click tracking (works with CF Web Analytics / Zaraz dataLayer)
    document.addEventListener('click', (ev) => {
      const a = ev.target.closest('[data-cta]');
      if (!a) return;
      try {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'cta_click', cta: a.getAttribute('data-cta'), href: a.getAttribute('href') });
      } catch (e) {}
    });
    // Theme toggle (progressive enhancement — button rendered in Nav)
    document.addEventListener('click', (ev) => {
      const btn = ev.target.closest('[data-theme-toggle]');
      if (!btn) return;
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('sdl-theme', next); } catch (e) {}
      btn.setAttribute('aria-pressed', String(next === 'dark'));
    });
  </script>
</body>
</html>
