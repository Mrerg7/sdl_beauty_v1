---
const email = 'sales@desertrich.com';
---
<header class="nav-wrap">
  <nav class="nav-inner container" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="SDL Beauty — home">
      <svg width="120" height="32" viewBox="0 0 120 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <text x="0" y="26" font-family="'Cormorant Garamond', Georgia, serif" font-size="26" font-weight="600" fill="currentColor" letter-spacing="6">SDL</text>
        <circle cx="95" cy="10" r="3" fill="var(--color-rose)" />
      </svg>
      <span class="nav-logo-sub">Beauty</span>
    </a>
    <a href={`mailto:${email}`} class="btn-cta" aria-label="Acquire SDL Beauty brand">
      Move It Forward
    </a>
  </nav>
</header>

<style>
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(245, 240, 232, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(42, 34, 24, 0.08);
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: var(--space-4);
}
.nav-logo {
  display: flex;
  align-items: baseline;
  gap: .35rem;
  color: var(--color-text);
  font-family: 'Cormorant Garamond', Georgia, serif;
  transition: opacity 200ms;
}
.nav-logo:hover { opacity: .75; }
.nav-logo-sub {
  font-family: 'Jost', sans-serif;
  font-size: var(--text-xs);
  font-weight: 300;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}
@media (max-width: 480px) {
  .btn-cta { padding: .7rem 1.25rem; font-size: .7rem; }
}
</style>
