---
export interface Props {
  images: string[];
}
const { images } = Astro.props;
const captions = [
  'Scottsdale luxury aesthetic — refined environments',
  'The SDL Beauty brand vision — elevated med spa experience',
  'Desert luxury — where wellness meets architecture',
];
---
<section class="gallery" aria-label="Brand imagery">
  <div class="container gallery-container">
    <div class="gallery-eyebrow reveal">
      <p class="ornament">Visual Identity</p>
    </div>
    <div class="gallery-grid">
      {images.map((src, i) => (
        <figure class={`gallery-item gallery-item--${i} reveal`} style={`--delay:${i * 0.12}s`}>
          <img
            src={src}
            alt={captions[i]}
            width="800"
            height="600"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="gallery-photo"
          />
          <figcaption class="gallery-caption">{captions[i]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
.gallery {
  padding-block: clamp(var(--space-12), 6vw, var(--space-20));
  background: var(--color-bg);
}
.gallery-eyebrow { margin-bottom: var(--space-8); }
.gallery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: var(--space-4);
}
.gallery-item {
  margin: 0;
  overflow: hidden;
  border-radius: var(--radius-lg);
  transition-delay: var(--delay);
}
.gallery-item--0 { grid-column: 1 / 2; grid-row: 1 / 3; }
.gallery-item--1 { grid-column: 2 / 3; grid-row: 1 / 2; }
.gallery-item--2 { grid-column: 2 / 3; grid-row: 2 / 3; }
.gallery-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .6s ease;
}
.gallery-item:hover .gallery-photo { transform: scale(1.03); }
.gallery-caption {
  font-size: var(--text-xs);
  font-weight: 300;
  letter-spacing: .1em;
  color: var(--color-text-faint);
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg);
}
@media (max-width: 600px) {
  .gallery-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
  .gallery-item--0, .gallery-item--1, .gallery-item--2 { grid-column: auto; grid-row: auto; }
}
</style>
