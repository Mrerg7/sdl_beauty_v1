---
export interface Props {
  images: string[];
  email: string;
}
const { images, email } = Astro.props;
---
<section class="hero" aria-label="SDL Beauty hero">
  <div class="hero-images" aria-hidden="true">
    {images.map((src, i) => (
      <div class={`hero-img hero-img--${i}`} style={`background-image:url('${src}')`} />
    ))}
    <div class="hero-overlay" />
  </div>

  <div class="hero-content container">
    <p class="hero-eyebrow ornament">Scottsdale, Arizona</p>
    <h1 class="hero-headline">
      The Beverly Hills<br />
      <em>of the Desert.</em>
    </h1>
    <p class="hero-sub">
      SDL Beauty — a rare, ready-to-launch luxury med spa brand built for<br class="d-none-mobile" />
      Arizona's most prestigious ZIP code. Domain. Identity. Positioning.<br class="d-none-mobile" />
      Fully yours.
    </p>
    <div class="hero-cta-wrap">
      <a href={`mailto:${email}`} class="btn-cta">
        Acquire This Brand
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <span class="hero-cta-note">{email}</span>
    </div>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: flex-end;
  padding-bottom: clamp(var(--space-12), 8vw, var(--space-24));
  overflow: hidden;
}
.hero-images { position: absolute; inset: 0; z-index: 0; }
.hero-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  animation: heroFade 18s ease-in-out infinite;
}
.hero-img--0 { animation-delay: 0s; }
.hero-img--1 { animation-delay: 6s; }
.hero-img--2 { animation-delay: 12s; }
@keyframes heroFade {
  0%   { opacity: 0; }
  5%   { opacity: 1; }
  30%  { opacity: 1; }
  35%  { opacity: 0; }
  100% { opacity: 0; }
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(30, 20, 10, 0.25) 0%,
    rgba(20, 14, 6, 0.72) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 1;
  color: #fff;
  max-width: 860px;
}
.hero-eyebrow {
  color: rgba(212, 180, 122, 0.9);
  font-size: var(--text-xs);
  letter-spacing: .22em;
  margin-bottom: var(--space-6);
}
.hero-eyebrow::before, .hero-eyebrow::after { background: rgba(212, 180, 122, 0.5); }
.hero-headline {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: var(--text-hero);
  font-weight: 300;
  line-height: 1.08;
  color: #fff;
  margin-bottom: var(--space-8);
}
.hero-headline em {
  font-style: italic;
  color: #d4b47a;
  font-weight: 300;
}
.hero-sub {
  font-family: 'Jost', sans-serif;
  font-size: var(--text-base);
  font-weight: 300;
  color: rgba(255,255,255,.8);
  line-height: 1.7;
  max-width: 58ch;
  margin-bottom: var(--space-10);
}
.hero-cta-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
}
.hero-cta-note {
  font-size: var(--text-xs);
  font-weight: 300;
  letter-spacing: .1em;
  color: rgba(255,255,255,.55);
}
@media (max-width: 600px) {
  .hero-headline { font-size: clamp(2.4rem, 10vw, 4rem); }
  .d-none-mobile { display: none; }
  .hero-cta-note { display: none; }
}
</style>
